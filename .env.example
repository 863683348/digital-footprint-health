# Google OAuth (login / identity binding) — copy to .env.local and fill in.
# Create credentials at: https://console.cloud.google.com/apis/credentials
#   OAuth 2.0 Client ID (type: Web application)
#   Authorized redirect URI: https://digital-footprint-health.vercel.app/api/auth/callback
#   (for local dev also add: http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie (HMAC). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Upstash Redis (shared by rate limiter + order state) — optional in dev,
# REQUIRED in production for payment order persistence.
# Create at: https://console.upstash.com (REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Waffo Pancake (payment) — copy to .env.local and fill in.
# Waffo is a hosted-redirect + webhook payment provider (no client SDK needed).
# Dashboard: https://dashboard.waffo.ai  (merchant id + private key under API keys)
#   WAFFO_MERCHANT_ID — your Waffo merchant id (sent as X-Merchant-Id header)
#   WAFFO_PRIVATE_KEY — merchant secret (HMAC request signing + webhook verify)
#   WAFFO_ENV          — 'sandbox' (default) | 'production'
#   WAFFO_WEBHOOK_SECRET — optional override for webhook HMAC (defaults to PRIVATE_KEY)
# Webhook endpoint to register: https://your-domain.com/api/webhooks/waffo
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_ENV=sandbox
WAFFO_WEBHOOK_SECRET=

# Google AdSense (display ads) — copy to .env.local and fill in.
# Find your publisher id in the AdSense dashboard: https://www.google.com/adsense
#   It looks like ca-pub-0000000000000000. Used by the global loader script and
#   every <AdUnit>. If empty, ads are skipped (pages stay clean, builds never fail).
#   Provisioned publisher id: ca-pub-9043592188127461
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-9043592188127461
