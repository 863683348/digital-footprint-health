# Google OAuth (login / identity binding) — copy to .env.local and fill in.
# Create credentials at: https://console.cloud.google.com/apis/credentials
#   OAuth 2.0 Client ID (type: Web application)
#   Authorized redirect URI: https://digital-footprint-health.vercel.app/api/auth/callback
#   (for local dev also add: http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie (HMAC). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Upstash Redis — ONLY used by the request rate limiter (middleware.ts).
# Optional: if both vars are set it uses a shared multi-instance limiter,
# otherwise it degrades to an in-memory sliding window. NOT used for orders.
# Create at: https://console.upstash.com (REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Neon PostgreSQL — REQUIRED in production for payment order persistence.
# Waffo checkout records are stored here via @neondatabase/serverless.
# Get the pooled connection string from your Neon dashboard (sslmode=require).
DATABASE_URL=

# Waffo Pancake (payment) — copy to .env.local and fill in.
# Waffo is a Merchant-of-Record platform. We use the official SDK
# @waffo/pancake-ts; checkouts are PRODUCT-based (create products in the
# Waffo Dashboard, then map each plan to a productId below).
# Dashboard: https://dashboard.waffo.ai  (merchant id + RSA private key under API keys)
#   WAFFO_MERCHANT_ID        — your Waffo merchant id (e.g. MER_xxx)
#   WAFFO_PRIVATE_KEY        — RSA private key PEM (signs server→Waffo calls)
#   WAFFO_WEBHOOK_PUBLIC_KEY — RSA public key PEM (verifies Waffo→server webhooks)
#   WAFFO_ENV                — informational label only (test vs prod merchant);
#                              the API host is ALWAYS https://api.waffo.ai (the
#                              environment is bound to the merchant account)
#   WAFFO_STORE_ID           — store the products belong to (needed for refunds)
#   WAFFO_PRODUCT_*          — productId for each paid plan (from the Dashboard)
# Webhook endpoint to register: https://your-domain.com/api/webhooks/waffo
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_WEBHOOK_PUBLIC_KEY=
WAFFO_ENV=sandbox
WAFFO_STORE_ID=
WAFFO_PRODUCT_SINGLE_SMALL=
WAFFO_PRODUCT_SINGLE_MEDIUM=
WAFFO_PRODUCT_SINGLE_LARGE=
WAFFO_PRODUCT_SINGLE_PRO_MONTHLY=
WAFFO_PRODUCT_SINGLE_PRO_ANNUAL=

# Google AdSense (display ads) — copy to .env.local and fill in.
# Find your publisher id in the AdSense dashboard: https://www.google.com/adsense
#   It looks like ca-pub-0000000000000000. Used by the global loader script and
#   every <AdUnit>. If empty, ads are skipped (pages stay clean, builds never fail).
#   Provisioned publisher id: ca-pub-9043592188127461
NEXT_PUBLIC_GOOGLE_ADSENSE_CLIENT=ca-pub-9043592188127461
