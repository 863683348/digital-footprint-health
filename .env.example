# Google OAuth (login / identity binding) — copy to .env.local and fill in.
# Create credentials at: https://console.cloud.google.com/apis/credentials
#   OAuth 2.0 Client ID (type: Web application)
#   Authorized redirect URI: https://digital-footprint-health.vercel.app/api/auth/callback
#   (for local dev also add: http://localhost:3000/api/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret used to sign the session cookie (HMAC). Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Upstash Redis (shared by rate limiter + order state) — optional in dev,
# REQUIRED in production for payment order persistence.
# Create at: https://console.upstash.com (REST API)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PayPal (payment) — copy to .env.local and fill in.
# Create a REST app at: https://developer.paypal.com/dashboard/applications/sandbox
#   Client ID + Secret from the "Default Application" or a new REST app.
#   Webhook: add https://your-domain.com/api/webhooks/paypal and copy the Webhook ID.
#   NEXT_PUBLIC_PAYPAL_CLIENT_ID is the SAME as PAYPAL_CLIENT_ID (safe to expose).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
